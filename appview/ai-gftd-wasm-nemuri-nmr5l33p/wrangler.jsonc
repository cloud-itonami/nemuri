{
  "$schema": "node_modules/wrangler/config-schema.json",
  // CLJC :esm fetch worker (ADR-2607061200 / ADR-2606290000 "worker は全て
  // CLJC のみに", pattern per orgs/kotoba-lang/kotobase-cljc-worker). Build:
  // `npm install && npm run build` -> out/worker.js (default export {fetch}).
  // Routes POST/GET /xrpc/{nsid} directly to the zero-I/O nemuri.core plan
  // surface (clj/src/nemuri/{core,registry,xrpc}.cljc) — the dead
  // dispatcher.gftd.ai hop (k8s cluster gone, owner directive: prune) is
  // removed, not replaced.
  "name": "ai-gftd-wasm-nemuri-nmr5l33p",
  "compatibility_date": "2026-06-01",
  "main": "out/worker.js",
  "routes": [
    { "pattern": "nubatama.net/*", "zone_name": "nubatama.net" },
    { "pattern": "www.nubatama.net/*", "zone_name": "nubatama.net" },
    { "pattern": "nemuri.gftd.ai/*", "zone_name": "gftd.ai" }
  ]
}
